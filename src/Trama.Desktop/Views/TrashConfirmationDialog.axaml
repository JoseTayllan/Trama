<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Trama.Desktop.Views.TrashConfirmationDialog" Title="Enviar para a lixeira"
        Width="540" Height="300" MinWidth="420" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource TramaWindowBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
    <TextBlock x:Name="TrashHeading" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TramaTextBrush}" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" x:Name="TrashImpact" FontSize="14" Margin="0,16,0,8" Foreground="{DynamicResource TramaMutedBrush}" TextWrapping="Wrap" />
    <TextBlock Grid.Row="2" Text="O conteúdo ficará na lixeira e poderá ser restaurado. Nenhuma imagem será apagada."
               FontSize="13" Foreground="{DynamicResource TramaSubtleBrush}" TextWrapping="Wrap" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelTrashButton" Content="Cancelar" Classes="notebook-add" IsCancel="True" IsDefault="True" Click="CancelClicked" />
      <Button x:Name="ConfirmTrashButton" Content="Enviar para a lixeira" Classes="trama-primary" Padding="16,10" Click="ConfirmClicked" />
    </StackPanel>
  </Grid>
</Window>
