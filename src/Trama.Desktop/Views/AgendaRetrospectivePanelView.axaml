<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Trama.Desktop.ViewModels" xmlns:agenda="using:Trama.Application.Agenda"
             xmlns:views="using:Trama.Desktop.Views" x:Class="Trama.Desktop.Views.AgendaRetrospectivePanelView" x:DataType="vm:AgendaViewModel">
  <UserControl.Resources>
    <views:AgendaPresentationConverter x:Key="AgendaPresentation" />
    <views:AgendaRetrospectivePresentationConverter x:Key="RetrospectivePresentation" />
    <StreamGeometry x:Key="RetroCalendar">M3,6 L21,6 21,21 3,21 Z M7,3 L7,9 M17,3 L17,9 M3,11 L21,11 M7,15 L11,15 M7,18 L15,18</StreamGeometry>
    <StreamGeometry x:Key="RetroCheck">M21,12 A9,9 0 1 1 12,3 M7,11 L11,15 21,5</StreamGeometry>
    <StreamGeometry x:Key="RetroChart">M4,20 L4,14 M10,20 L10,10 M16,20 L16,5 M22,20 L22,2</StreamGeometry>
    <StreamGeometry x:Key="RetroOpen">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12</StreamGeometry>
    <StreamGeometry x:Key="RetroLayers">M2,7 L12,2 22,7 12,12 Z M2,12 L12,17 22,12 M2,17 L12,22 22,17</StreamGeometry>
    <StreamGeometry x:Key="RetroTasks">M3,5 L5,7 8,3 M11,5 L22,5 M3,13 L5,15 8,11 M11,13 L22,13 M3,21 L5,23 8,19 M11,21 L22,21</StreamGeometry>
    <StreamGeometry x:Key="RetroWork">M3,7 L21,7 21,21 3,21 Z M8,7 L8,3 16,3 16,7 M3,12 Q12,17 21,12 M10,12 L14,12 14,16 10,16 Z</StreamGeometry>
    <StreamGeometry x:Key="RetroStudy">M1,8 L12,3 23,8 12,13 Z M5,10 L5,17 Q12,22 19,17 L19,10 M23,8 L23,18</StreamGeometry>
    <StreamGeometry x:Key="RetroPerson">M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7 M4,22 L4,18 Q4,13 12,13 Q20,13 20,18 L20,22 Z</StreamGeometry>
    <StreamGeometry x:Key="RetroReflection">M13,4 L4,4 4,22 21,22 21,13 M10,15 L11,10 19,2 23,6 15,14 Z M17,4 L21,8</StreamGeometry>
    <LinearGradientBrush x:Key="RetroCardSurface" StartPoint="0,0" EndPoint="1,1"><GradientStop Offset="0" Color="{DynamicResource TramaColorSurface}" /><GradientStop Offset="1" Color="{DynamicResource TramaColorInput}" /></LinearGradientBrush>
    <SolidColorBrush x:Key="RetroCardOutline" Color="{DynamicResource TramaColorSyntaxType}" Opacity="0.38" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.retro-card"><Setter Property="Background" Value="{StaticResource RetroCardSurface}" /><Setter Property="BorderBrush" Value="{StaticResource RetroCardOutline}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="20" /></Style>
    <Style Selector="TextBlock.retro-label"><Setter Property="Foreground" Value="{DynamicResource TramaMutedBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.retro-number"><Setter Property="FontSize" Value="36" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.retro-title"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource TramaAccentBrush}" /><Setter Property="Background" Value="{DynamicResource TramaRaisedBrush}" /></Style>
    <Style Selector="ProgressBar.retrospective-planned-bar"><Setter Property="Foreground" Value="{DynamicResource TramaSyntaxTypeBrush}" /></Style>
    <Style Selector="ProgressBar.retrospective-planned-bar, ProgressBar.retrospective-completed-bar"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Path.retro-icon"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Stroke" Value="{DynamicResource TramaAccentBrush}" /><Setter Property="StrokeThickness" Value="1.7" /><Setter Property="StrokeLineCap" Value="Round" /><Setter Property="StrokeJoin" Value="Round" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Border.retro-icon-plate"><Setter Property="BorderBrush" Value="{DynamicResource TramaMutedBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" /><Setter Property="Padding" Value="4,6,18,6" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Path.retro-category-icon"><Setter Property="Data" Value="{StaticResource RetroPerson}" /><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="Stroke" Value="{DynamicResource TramaMutedBrush}" /></Style>
    <Style Selector="Path.retro-category-icon.work"><Setter Property="Data" Value="{StaticResource RetroWork}" /></Style>
    <Style Selector="Path.retro-category-icon.study"><Setter Property="Data" Value="{StaticResource RetroStudy}" /></Style>
    <Style Selector="Border.retrospective-category"><Setter Property="BorderBrush" Value="{DynamicResource TramaBorderBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="0,0,0,14" /></Style>
    <Style Selector="Border.retro-category-stripe"><Setter Property="Background" Value="{DynamicResource TramaAgendaPersonalBrush}" /><Setter Property="Width" Value="4" /><Setter Property="CornerRadius" Value="2" /></Style>
    <Style Selector="Border.retro-category-stripe.work"><Setter Property="Background" Value="{DynamicResource TramaAgendaWorkBrush}" /></Style>
    <Style Selector="Border.retro-category-stripe.study"><Setter Property="Background" Value="{DynamicResource TramaAgendaStudyBrush}" /></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="AgendaRetrospectiveScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="0,0,8,8">
      <Grid x:Name="RetrospectiveHeader" ColumnDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="10">
        <StackPanel Spacing="5" VerticalAlignment="Center">
          <TextBlock x:Name="AgendaRetrospectiveHeading" Text="{Binding RetrospectiveHeading}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="AgendaRetrospectiveCapturedAt" Text="{Binding RetrospectiveCapturedAt}" Classes="retro-label" FontSize="11" />
        </StackPanel>
        <WrapPanel x:Name="RetrospectiveHeaderActions" Grid.Column="1" VerticalAlignment="Center">
          <Border BorderBrush="{DynamicResource TramaAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,12,4"><TextBlock Text="✓ Semana encerrada" Foreground="{DynamicResource TramaAccentBrush}" FontSize="12" /></Border>
          <Border BorderBrush="{StaticResource RetroCardOutline}" BorderThickness="1" CornerRadius="7" Margin="0,0,8,4" Background="{DynamicResource TramaInputBrush}">
            <Grid ColumnDefinitions="Auto,Auto,Auto">
              <Button x:Name="AgendaRetrospectivePreviousButton" Content="‹" ToolTip.Tip="Semana anterior" AutomationProperties.Name="Abrir retrospectiva da semana anterior" Classes="notebook-tool" IsEnabled="{Binding CanPreviousRetrospective}" Click="PreviousClicked" Padding="12,2" FontSize="22" />
              <Border Grid.Column="1" BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="1,0" Padding="12,8"><TextBlock Text="{Binding RetrospectiveHeading}" FontSize="12" VerticalAlignment="Center" /></Border>
              <Button Grid.Column="2" x:Name="AgendaRetrospectiveNextButton" Content="›" ToolTip.Tip="Próxima semana encerrada" AutomationProperties.Name="Abrir retrospectiva da próxima semana encerrada" Classes="notebook-tool" IsEnabled="{Binding CanNextRetrospective}" Click="NextClicked" Padding="12,2" FontSize="22" />
            </Grid>
          </Border>
          <Button x:Name="AgendaRetrospectiveRefreshButton" Content="Atualizar" AutomationProperties.Name="Atualizar fechamento semanal preservado" Classes="notebook-add" IsEnabled="{Binding CanEdit}" Click="RefreshClicked" Margin="0,0,0,4" Padding="10,7" />
        </WrapPanel>
      </Grid>
      <UniformGrid x:Name="AgendaRetrospectiveIndicators" Columns="4">
        <Border Classes="retro-card" Margin="0,0,10,10"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="18"><Border Classes="retro-icon-plate"><Path Classes="retro-icon" Data="{StaticResource RetroCalendar}" Stroke="{DynamicResource TramaSyntaxTypeBrush}" /></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="AgendaRetrospectivePlannedCount" Text="{Binding Retrospective.Report.PlannedCount}" Classes="retro-number" /><TextBlock Text="Tarefas planejadas" Classes="retro-label" /></StackPanel></Grid></Border>
        <Border Classes="retro-card" Margin="0,0,10,10"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="18"><Border Classes="retro-icon-plate"><Path Classes="retro-icon" Data="{StaticResource RetroCheck}" /></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="AgendaRetrospectiveCompletedCount" Text="{Binding Retrospective.Summary.CompletedCount}" Classes="retro-number" /><TextBlock Text="Concluídas nesta semana" Classes="retro-label" /></StackPanel></Grid></Border>
        <Border Classes="retro-card" Margin="0,0,10,10"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="18"><Border Classes="retro-icon-plate"><Path Classes="retro-icon" Data="{StaticResource RetroChart}" /></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="AgendaRetrospectiveCompletion" Text="{Binding Retrospective.Summary.CompletionLabel}" Classes="retro-number" /><TextBlock Text="Conclusão da semana" Classes="retro-label" /><TextBlock x:Name="AgendaRetrospectiveComparison" Text="{Binding Retrospective.Summary.ComparisonLabel}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TramaAccentBrush}" /></StackPanel></Grid></Border>
        <Border Classes="retro-card" Margin="0,0,0,10"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="18"><Border Classes="retro-icon-plate"><Path Classes="retro-icon" Data="{StaticResource RetroOpen}" Stroke="{DynamicResource TramaSyntaxTypeBrush}" /></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="AgendaRetrospectiveOpenCount" Text="{Binding Retrospective.Summary.OpenCount}" Classes="retro-number" /><TextBlock Text="Ainda em aberto" Classes="retro-label" /><TextBlock x:Name="AgendaRetrospectiveOpenBreakdown" Text="{Binding Retrospective.Summary.OpenBreakdownLabel}" Classes="retro-label" FontSize="11" /></StackPanel></Grid></Border>
      </UniformGrid>
      <Border x:Name="AgendaRetrospectiveEmpty" Classes="retro-card" IsVisible="{Binding IsRetrospectiveEmpty}"><TextBlock Text="Sem tarefas neste fechamento. Você pode consultar outra semana; nenhum percentual foi estimado." Classes="retro-label" /></Border>
      <Grid x:Name="RetrospectiveDetailsGrid" ColumnDefinitions="*,340" ColumnSpacing="16" RowSpacing="16">
        <Border x:Name="AgendaRetrospectiveDays" Classes="retro-card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Path Classes="retro-icon" Data="{StaticResource RetroChart}" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Planejado × concluído" Classes="retro-title" /><TextBlock Text="Inícios planejados e conclusões reais por dia" Classes="retro-label" /></StackPanel></Grid>
            <WrapPanel HorizontalAlignment="Right"><TextBlock Text="■ Planejadas" Foreground="{DynamicResource TramaSyntaxTypeBrush}" Margin="0,0,20,0" FontSize="12" /><TextBlock Text="■ Concluídas" Foreground="{DynamicResource TramaAccentBrush}" FontSize="12" /></WrapPanel>
            <Grid Height="192">
            <Grid RowDefinitions="*,*,*,*" Margin="0,20,0,22" IsHitTestVisible="False"><Border BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="0,0,0,1" Opacity="0.55" /><Border Grid.Row="1" BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="0,0,0,1" Opacity="0.55" /><Border Grid.Row="2" BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="0,0,0,1" Opacity="0.55" /><Border Grid.Row="3" BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="0,0,0,1" /></Grid>
            <ItemsControl ItemsSource="{Binding Retrospective.Summary.Days}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="agenda:AgendaRetrospectiveDay">
                  <Border Classes="retrospective-day" Padding="3,0">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="30,30" RowDefinitions="Auto,140" HorizontalAlignment="Center" ColumnSpacing="5" RowSpacing="5" ClipToBounds="True">
                        <TextBlock Text="{Binding PlannedCount}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding CompletedCount}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        <Border Grid.Row="1" ClipToBounds="True" Height="140"><ProgressBar Classes="retrospective-planned-bar" Orientation="Vertical" Height="140" MaxHeight="140" Value="{Binding PlannedCount}" Maximum="{ReflectionBinding $parent[UserControl].DataContext.RetrospectiveChartMaximum}" Minimum="0" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Converter={StaticResource RetrospectivePresentation}, ConverterParameter=planned-name}" /></Border>
                        <Border Grid.Row="1" Grid.Column="1" ClipToBounds="True" Height="140"><ProgressBar Classes="retrospective-completed-bar" Orientation="Vertical" Height="140" MaxHeight="140" Value="{Binding CompletedCount}" Maximum="{ReflectionBinding $parent[UserControl].DataContext.RetrospectiveChartMaximum}" Minimum="0" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Converter={StaticResource RetrospectivePresentation}, ConverterParameter=completed-name}" /></Border>
                      </Grid>
                      <TextBlock Text="{Binding Converter={StaticResource RetrospectivePresentation}, ConverterParameter=day}" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TramaMutedBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
            <TextBlock Text="Uma tarefa por total · continuidades anteriores indicadas nos avisos" Classes="retro-label" FontSize="11" />
          </StackPanel>
        </Border>
        <Border x:Name="AgendaRetrospectiveCategories" Grid.Column="1" Classes="retro-card">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="14"><Path Classes="retro-icon" Data="{StaticResource RetroLayers}" /><TextBlock Text="Por categoria" Classes="retro-title" VerticalAlignment="Center" /></StackPanel>
            <ItemsControl ItemsSource="{Binding Retrospective.Summary.Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="agenda:AgendaRetrospectiveCategory">
                  <Border Classes="retrospective-category" Margin="0,0,0,18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                      <Border Classes="retro-category-stripe" Classes.work="{Binding Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=work}" Classes.study="{Binding Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=study}" />
                      <StackPanel Grid.Column="1" Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Path Classes="retro-icon retro-category-icon" Classes.work="{Binding Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=work}" Classes.study="{Binding Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=study}" /><TextBlock Grid.Column="1" Text="{Binding Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=category}" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource RetrospectivePresentation}, ConverterParameter=category-counts}" Classes="retro-label" FontSize="11" VerticalAlignment="Center" /></Grid>
                        <ProgressBar Height="8" Value="{Binding CompletedCount}" Maximum="{Binding Converter={StaticResource RetrospectivePresentation}, ConverterParameter=category-max}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel Spacing="8"><TextBlock Text="O assunto é indicado pela categoria." Classes="retro-label" FontSize="11" /><WrapPanel><TextBlock Text="○ Pendente" Classes="retro-label" Margin="0,0,14,0" FontSize="11" /><TextBlock Text="◐ Em andamento" Classes="retro-label" Margin="0,0,14,0" FontSize="11" /><TextBlock Text="✓ Concluída" Classes="retro-label" FontSize="11" /></WrapPanel></StackPanel></Border>
          </StackPanel>
        </Border>
      </Grid>
      <Border x:Name="AgendaRetrospectiveWarnings" Padding="14,10" BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel Spacing="4"><ItemsControl ItemsSource="{Binding Retrospective.Summary.DataQualityMessages}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="retro-label" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="O percentual considera apenas conclusões com data dentro da semana." Classes="retro-label" FontSize="11" /></StackPanel>
      </Border>
      <Grid x:Name="RetrospectiveBottomGrid" ColumnDefinitions="1.35*,*" ColumnSpacing="16" RowSpacing="16">
      <Border x:Name="AgendaRetrospectiveOpenTasks" Classes="retro-card">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="14"><Path Classes="retro-icon" Data="{StaticResource RetroTasks}" /><TextBlock Text="Pendências para revisar" Classes="retro-title" VerticalAlignment="Center" /></StackPanel>
          <TextBlock Text="{Binding Retrospective.Summary.OpenBreakdownLabel, StringFormat='No fechamento: {0}'}" Classes="retro-label" />
          <ItemsControl ItemsSource="{Binding Retrospective.Summary.OpenTasks}" IsEnabled="{Binding CanEdit}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="agenda:AgendaRetrospectiveTask">
                <Border Classes="retrospective-open-task" Background="{DynamicResource TramaInputBrush}" BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="retro-category-stripe" Classes.work="{Binding Task.Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=work}" Classes.study="{Binding Task.Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=study}" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,11,14,11">
                      <TextBlock Text="{Binding Task.Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Grid Grid.Column="1" ColumnDefinitions="106,166" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Path Classes="retro-icon retro-category-icon" Width="19" Height="19" Classes.work="{Binding Task.Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=work}" Classes.study="{Binding Task.Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=study}" />
                          <TextBlock Text="{Binding Task.Category, Converter={StaticResource AgendaPresentation}, ConverterParameter=category}" Classes="retro-label" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0">
                          <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource RetrospectivePresentation}">
                                  <Binding Path="Task.Id" />
                                  <ReflectionBinding Path="$parent[UserControl].DataContext.Retrospective.CurrentPendingStatuses" />
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Text="{Binding Task.Status, Converter={StaticResource AgendaPresentation}, ConverterParameter=status-icon}" Foreground="{DynamicResource TramaAccentBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Task.Status, Converter={StaticResource AgendaPresentation}, ConverterParameter=closure-status}" Classes="retro-label" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </Grid>
                      <Button x:Name="AgendaRetrospectiveOpenTaskButton" Grid.Column="2"
                              Content="Abrir tarefa" AutomationProperties.Name="{Binding Task.Title, StringFormat='Abrir tarefa: {0}'}"
                              Classes="notebook-add" VerticalAlignment="Center" Click="OpenTaskClicked" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border BorderBrush="{DynamicResource TramaBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><TextBlock Text="Abra a tarefa para consultar os dados atuais." Classes="retro-label" FontSize="11" TextWrapping="Wrap" /></Border>
        </StackPanel>
      </Border>
      <Border x:Name="AgendaRetrospectiveReflection" Grid.Column="1" Classes="retro-card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="14"><Path Classes="retro-icon" Data="{StaticResource RetroReflection}" /><TextBlock Text="Sua retrospectiva" Classes="retro-title" VerticalAlignment="Center" /></StackPanel>
          <StackPanel Grid.Row="1" Spacing="14">
            <StackPanel Spacing="7">
              <TextBlock Text="O que funcionou bem?" FontSize="14" FontWeight="SemiBold" />
              <TextBox x:Name="AgendaReflectionWorkedInput" AutomationProperties.Name="O que funcionou bem?" Text="{Binding Retrospective.WorkedWell, Mode=TwoWay}" IsReadOnly="{Binding !CanEditReflection}" AcceptsReturn="True" TextWrapping="Wrap" Classes="trama-input" MinHeight="66" Padding="12,10" Watermark="Ex.: manter o foco nas prioridades, avançar nos estudos…" />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Text="O que você quer ajustar?" FontSize="14" FontWeight="SemiBold" />
              <TextBox x:Name="AgendaReflectionAdjustInput" AutomationProperties.Name="O que você quer ajustar?" Text="{Binding Retrospective.Adjustments, Mode=TwoWay}" IsReadOnly="{Binding !CanEditReflection}" AcceptsReturn="True" TextWrapping="Wrap" Classes="trama-input" MinHeight="66" Padding="12,10" Watermark="Ex.: redistribuir tarefas, reservar mais tempo para estudar…" />
            </StackPanel>
            <TextBlock Text="{Binding Retrospective.ReflectionFeedback}" AutomationProperties.LiveSetting="Polite" Classes="retro-label" FontSize="11" />
          </StackPanel>
          <Button Grid.Row="2" x:Name="AgendaReflectionSaveButton" AutomationProperties.Name="Salvar reflexão" IsEnabled="{Binding CanSaveReflection}" Click="SaveReflectionClicked" HorizontalAlignment="Right" BorderBrush="{DynamicResource TramaAccentBrush}" BorderThickness="1" Background="Transparent" Foreground="{DynamicResource TramaAccentBrush}" CornerRadius="8" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="✓" /><TextBlock Text="Salvar reflexão" FontWeight="SemiBold" /></StackPanel>
          </Button>
        </Grid>
      </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
