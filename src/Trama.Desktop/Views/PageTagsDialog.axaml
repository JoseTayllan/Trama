<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Trama.Desktop.Views.PageTagsDialog"
        Title="Tags da página" Width="520" Height="390" MinWidth="430" MinHeight="340"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource TramaWindowBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
    <TextBlock Text="Tags da página" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TramaTextBrush}" />
    <TextBlock Grid.Row="1" Text="Uma tag por linha. Deixe vazio para remover todas. Seu texto em edição será mantido."
               TextWrapping="Wrap" Margin="0,10,0,16" Foreground="{DynamicResource TramaMutedBrush}" FontSize="13" />
    <TextBox Grid.Row="2" x:Name="PageTagsInput" Classes="trama-input" AcceptsReturn="True" TextWrapping="Wrap"
             Watermark="c#&#10;estudo&#10;revisão" VerticalContentAlignment="Top" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelTagsButton" Content="Cancelar" Classes="notebook-add" IsCancel="True" Click="CancelClicked" />
      <Button x:Name="SaveTagsButton" Content="Salvar tags" Classes="trama-primary" Click="SaveClicked" Padding="16,10" />
    </StackPanel>
  </Grid>
</Window>
